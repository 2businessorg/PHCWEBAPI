{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "ApiSettings": {
    "BaseUrl": "http://localhost:7298"
  },
  "PhcWeb": {
    "Scripts": {
      "InsertBo": {
        "Code": "insertBoAPI"
      },
      "InsertRe": {
        "Code": "insertReAPI"
      },
      "InsertFt": {
        "Code": "insertFtAPI"
      },
      "InsertSt": {
        "Code": "insertStAPI"
      },
      "InsertCl": {
        "Code": "insertClAPI"
      },
      "InsertRd": {
        "Code": "insertRdAPI"
      }
    }
  },
  
  "ConnectionStrings": {
    //"ParametersConnection": "Server=(localdb)\mssqllocaldb;Database=ParametersDb;Trusted_Connection=true;MultipleActiveResultSets=true",
    //"DBconnect2B": "Server=YOUR_SERVER;Database=YOUR_DB;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;"
    "DBconnect": "Server=YOUR_SERVER;Database=YOUR_DB;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning",
        "Hangfire": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Auth": "Information",
        "PHCAPI.Host.Middleware": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/PHCAPI-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },

  "LocalAI": {
    "Provider": "Qwen",
    "BaseUrl": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
    "Model": "qwen3-coder-next",
    "ApiKey": "",
    "TimeoutSeconds": 1200,
    "Think": false
  },
  "Agent": {
    "MaxToolIterations": 10
  },
  "Pseudonymization": {
    "Enabled": true,
    "EnableCloudLlm": false,
    "PresidioBaseUrl": "http://127.0.0.1:5001",
    "PresidioTimeoutSeconds": 15,
    "Language": "pt",
    "TokenMapEncryptionKeyBase64": "",
    "TokenMapHmacKeyBase64": "",
    "DefaultMapTtlHours": 24,
    "ConservativeOnLowConfidence": true,
    "PseudonymizeEducation": false,
    "PreserveProfessionalSkills": true,
    "StrictDetoken": true,
    "EnableQuasiIdGeneralization": false,
    "EnableHybridNerV2": false,
    "RequireSidecarForCloudEgress": true,
    "TokenMapStore": "InMemory"
  },
  "DocumentTextExtraction": {
    "MinNativeCharacters": 40,
    "OcrEnabled": true,
    "OcrEngineName": "TesseractCli",
    "OcrLanguage": "eng",
    "TesseractExecutablePath": "",
    "TessDataPath": "",
    "OcrTimeoutSeconds": 60
  },
  "RecruitmentIa": {
    "Enabled": true,
    "EnableCloudLlm": true,
    "HangfireJobName": "Recruitment.AnalyzeCandidate",
    "OrphanTtlMinutes": 60,
    "AllowLabEnqueueWithoutRctclb": false,
    "LabGoRef": null,
    "QueueHostName": "PHCAPI.Host Hangfire (PHCHANGFIRE schema)",
    "Schema": {
      "ConnectionStringName": "DBconnect",
      "CveEstadoIaColumn": "u_estadoia",
      "AnexosTextoColumn": "u_texto",
      "SrtScoreIaColumn": "u_scoreia",
      "SrtJustIaColumn": "u_justia",
      "SrtModeloIaColumn": "u_modeloia",
      "RctIdColumn": "idrct",
      "SrtPromptVerIaColumn": "u_prmveria",
      "SrtStampIaColumn": "u_stampia",
      "SrtAuditIaColumn": "u_auditia",
      "RctCriteriaTable": "u_rec_ia_crt",
      "OutboxTable": "u_rec_ia_outbox"
    }
  },
  "AllowedHosts": "*",

  "AllowedOrigins": [
    "https://uat1.portmaputo.com:9000",
    "http://localhost:7298"
  ],
  "JWT": {
    "ValidAudience": "http://localhost:7298",
    "ValidIssuer": "http://localhost:7298",
    "Secret": "CHANGE_ME_JWT_SECRET",
    "ExpirationHours": 3
  },
